<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.7</version>
        <relativePath/>
    </parent>

    <groupId>br.com.fiap.phase4</groupId>
    <artifactId>15soat-phase4-lib-commons</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>15soat-phase4-lib-commons</name>
    <description>Centralized Multi-Module Commons Library for Phase 4 Microservices</description>

    <properties>
        <java.version>25</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <mapstruct.version>1.6.3</mapstruct.version>
        <springdoc-openapi.version>3.0.2</springdoc-openapi.version>
        <archunit.version>1.4.1</archunit.version>
    </properties>

    <modules>
        <module>mod-domain</module>
        <module>mod-web</module>
        <module>mod-kafka</module>
        <module>mod-postgres</module>
        <module>mod-mongo</module>
        <module>mod-aot</module>
        <module>mod-test</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- Internal submodules -->
            <dependency>
                <groupId>br.com.fiap.phase4</groupId>
                <artifactId>mod-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>br.com.fiap.phase4</groupId>
                <artifactId>mod-web</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>br.com.fiap.phase4</groupId>
                <artifactId>mod-kafka</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>br.com.fiap.phase4</groupId>
                <artifactId>mod-postgres</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>br.com.fiap.phase4</groupId>
                <artifactId>mod-mongo</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>br.com.fiap.phase4</groupId>
                <artifactId>mod-aot</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>br.com.fiap.phase4</groupId>
                <artifactId>mod-test</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- ArchUnit -->
            <dependency>
                <groupId>com.tngtech.archunit</groupId>
                <artifactId>archunit-junit5</artifactId>
                <version>${archunit.version}</version>
            </dependency>

            <!-- MapStruct -->
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct-processor</artifactId>
                <version>${mapstruct.version}</version>
                <scope>provided</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <source>${java.version}</source>
                        <target>${java.version}</target>
                        <parameters>true</parameters>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <configuration>
                        <argLine>-XX:+EnableDynamicAgentLoading</argLine>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
